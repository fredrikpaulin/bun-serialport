{
  "name": "bun-serialport",
  "version": "0.2.0",
  "description": "Bun-native serial port library using bun:ffi. No native compilation, no node-gyp.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./parsers": {
      "types": "./src/parsers/index.d.ts",
      "default": "./src/parsers/index.js"
    }
  },
  "scripts": {
    "test": "bun test tests/",
    "typecheck": "bun x tsc --noEmit -p tests/types"
  },
  "author": {
    "name": "Fredrik Paulin",
    "email": "fredrik@rymdskepp.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fredrikpaulin/bun-serialport"
  },
  "keywords": [
    "serial",
    "serialport",
    "bun",
    "ffi",
    "uart",
    "rs232",
    "robotics",
    "sensors",
    "hardware",
    "iot",
    "termios"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "files": [
    "src/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "types": "./src/index.d.ts"
}
